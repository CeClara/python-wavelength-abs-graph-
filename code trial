
import pandas as pd
import matplotlib.pyplot as plt

# Separator is the tab character / ignore first 2 rows
abs_data = pd.read_csv('absorption.txt', sep='\t', skiprows=2)
flour_data = pd.read_csv('fluorescence.txt', sep='\t', skiprows=2)

# Remove spaces before well names e.g. ' A04'
abs_data['Well'] = abs_data['Well'].str.strip()
flour_data['Well'] = flour_data['Well'].str.strip()

# equate Em to Wavelength so both files use the same column name
flour_data = flour_data.rename(columns={'Em': 'Wavelength'})


def normalise(values):
    # Use normalisation formula
    difference = values.max() - values.min()
    if difference == 0:
        raise ValueError('Cannot normalise a flat spectrum.')
    return (values - values.min()) / difference


def corrected_spectrum(data, well, measurement):
    sample = data[data['Well'] == well]
    blank = data[data['Well'] == 'A01']

    corrected = sample[measurement].values - blank[measurement].values

    return sample['Wavelength'], normalise(corrected)


def plot_spectra(ax, well, title, fluor_colour):

    abs_wavelength, abs_values = corrected_spectrum(abs_data, well, 'Abs')
    flour_wavelength, flour_values = corrected_spectrum(flour_data, well, 'RFU')

    # Absorption - grey dashed line
    ax.plot(abs_wavelength, abs_values, color='gray',
            linestyle='--', label='Absorption', linewidth=1.8)

    # Fluorescence - colour depends on sample
    ax.plot(flour_wavelength, flour_values, color=fluor_colour,
            label='Fluorescence emission', linewidth=1.8)

    ax.set_title(title, loc='left', fontweight='bold')
    ax.set_ylabel('Normalised intensity')
    ax.set_xlim(350, 610)
    ax.set_ylim(0, 1.05)
    ax.spines['top'].set_visible(False)
    ax.spines['right'].set_visible(False)


# A - eGFP control
fig, ax = plt.subplots(figsize=(7, 3.5))
plot_spectra(ax, 'C02', 'A   eGFP control', '#39FF14')
plt.tight_layout()
plt.savefig('eGFP_spectra.png', dpi=300)
plt.show()

# B - Y66W control
fig, ax = plt.subplots(figsize=(7, 3.5))
plot_spectra(ax, 'C03', 'B   Y66W control', 'gold')
plt.tight_layout()
plt.savefig('Y66W_control_spectra.png', dpi=300)
plt.show()

# C - Your Y66W mutant
fig, ax = plt.subplots(figsize=(7, 3.5))
plot_spectra(ax, 'A04', 'C   Y66W mutant', '#39FF14')
plt.tight_layout()
plt.savefig('Y66W_mutant_spectra.png', dpi=300)
plt.show()
